# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://crawler:crawler@localhost:5432/crawler?schema=public"

# Redis connection (BullMQ + pub/sub)
REDIS_URL="redis://localhost:6379"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Crawl engine defaults (optional overrides)
CRAWL_DEFAULT_CONCURRENCY="8"
CRAWL_REQUEST_TIMEOUT_MS="15000"
CRAWL_MAX_REDIRECT_HOPS="10"

# The bot-protection bypass is configured PER CRAWL, not here: the remote-browser
# endpoint, its Bearer token and any proxy are read from the crawl's own fields and
# nothing else. There are deliberately no PLAYWRIGHT_*_ENDPOINT / PLAYWRIGHT_AUTH_TOKEN /
# CRAWL_PROXY_* defaults — enter them on the new-crawl form (they are saved with the crawl,
# so "Redo crawl" reproduces the run exactly).

# Global default User-Agent. Suggestion — customise for your deployment. Used as the
# fallback when a user hasn't set their own default (Settings) and a crawl/API request
# omits a User-Agent. Examples:
#   CRAWL_DEFAULT_USER_AGENT="MyCompanyBot/1.0 (+https://mycompany.com/bot; seo-audit)"
#   CRAWL_DEFAULT_USER_AGENT="Mozilla/5.0 (compatible; Krawlify/1.0; +https://krawlify.com)"
CRAWL_DEFAULT_USER_AGENT="Krawlify/1.0 (+https://krawlify.com)"
